{
  "name": "merchant-agent",
  "version": "0.1.0",
  "description": "The protocol for agent-to-agent optimization (AAO). Framework-agnostic TypeScript SDK for the merchant-agent v0.1 spec — cross-sell, brand-story, and conditional-offer primitives a merchant publishes for buyer-agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "agentic-commerce",
    "merchant-agent",
    "agent-web",
    "merchandising",
    "ai-agents",
    "spec"
  ],
  "homepage": "https://github.com/VedSoni-dev/merchant-agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VedSoni-dev/merchant-agent.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/VedSoni-dev/merchant-agent/issues",
  "devDependencies": {
    "@types/node": "20.16.10",
    "typescript": "5.6.3",
    "vitest": "2.1.2"
  }
}
